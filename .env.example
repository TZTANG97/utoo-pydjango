# 数据库：复制 config/shared-database.env.example → config/shared-database.env 并填写 DB_*
# 所有 Django 服务（网关 + qd_svc_*）自动加载该文件；本机覆盖可用 .env.local

# Redis — 对齐 Java config-test.properties
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=1
REDIS_TIMEOUT=10000

# 服务
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT_HTTP=18083

# 微服务上游（MS-1+，可选）
# SVC_AUTH_URL=http://127.0.0.1:18081
# SVC_ORDER_URL=http://127.0.0.1:18082
# SVC_PAYMENT_URL=http://127.0.0.1:18084
# 微信回调公网根（预下单 notify_url 用，通常与网关一致）
# CORS_HTTPS=http://127.0.0.1:18083
# SVC_INVOICE_URL=http://127.0.0.1:18085
# SVC_ENTRY_URL=http://127.0.0.1:18086
API_PREFIX=/api
DEBUG_RELOAD=true

# Django
DJANGO_SECRET_KEY=change-me-in-production

# JWT（与 FastAPI 对齐，生产务必修改）
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 开发环境固定短信码
DEV_SMS_CODE=111111

# 支付调试 / 并发（D2 启用 Celery 任务）
PAY_DEBUG_ENABLED=true
PAY_NOTIFY_USE_QUEUE=true
PAY_USER_LOCK_SECONDS=30
PAY_NOTIFY_LOCK_SECONDS=120

# 阿里云短信
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=

# OSS
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_BUCKET=qgongye
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=https://qgongye.oss-cn-shanghai.aliyuncs.com

IMAGE_WEB_SERVER=https://uat.utoo.laide.tech
UPLOAD_DIR=upload
MAX_UPLOAD_SIZE=10485760

# 微信
WEIXIN_APPID=
WEIXIN_SECRET=
WEIXIN_GZH_APPID=
WEIXIN_GZH_SECRET=
WEIXIN_GZH_TOKEN=
WEIXIN_MERCHANT_ID=
WEIXIN_MERCHANT_SERIAL_NUMBER=
WEIXIN_API_V3_KEY=
WEIXIN_PRIVATE_KEY_PATH=e:/utoo/qd_test_server_django/certs/apiclient_key.pem
CORS_HTTPS=https://uat.utoo.laide.tech

# Celery（默认与 Redis 同机）
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
