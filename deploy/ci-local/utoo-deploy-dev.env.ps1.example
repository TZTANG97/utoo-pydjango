# 复制为 utoo-deploy-dev.env.ps1（勿提交）后供本机/Runner 调试加载：
#   copy deploy\ci-local\utoo-deploy-dev.env.ps1.example deploy\ci-local\utoo-deploy-dev.env.ps1
#
# 正式环境优先用 GitLab → Settings → CI/CD → Variables

$env:DEPLOY_USER = 'deploy'
$env:DEPLOY_HOST = 'your.dev.host.or.ip'
$env:SSH_PRIVATE_KEY = @'
-----BEGIN OPENSSH PRIVATE KEY-----
...paste key...
-----END OPENSSH PRIVATE KEY-----
'@

# 可选覆盖（默认见 .gitlab-ci.yml / ci-deploy-windows.ps1）
# $env:UTOO_REMOTE_ROOT = '/opt/utoo'
# $env:UTOO_STATIC_C = '/var/www/utoo-c'
# $env:UTOO_STATIC_ADMIN = '/var/www/utoo-admin'
# 微服务发版会依次 restart：qd-auth … qd-gateway（脚本内写死，无需在此列）
