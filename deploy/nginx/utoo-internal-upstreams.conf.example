# Install inside nginx http{} context, alongside the public Utoo server block.
# Each local listener is stable; its included file selects blue or green.

upstream utoo_order {
    include /usr/local/nginx/conf/utoo_upstream_order.conf;
    keepalive 16;
}

upstream utoo_payment {
    include /usr/local/nginx/conf/utoo_upstream_payment.conf;
    keepalive 16;
}

upstream utoo_admin_asset {
    include /usr/local/nginx/conf/utoo_upstream_admin_asset.conf;
    keepalive 16;
}

upstream utoo_admin_platform {
    include /usr/local/nginx/conf/utoo_upstream_admin_platform.conf;
    keepalive 16;
}

server {
    listen 127.0.0.1:19082;
    location / {
        proxy_pass http://utoo_order;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
    }
}

server {
    listen 127.0.0.1:19084;
    location / {
        proxy_pass http://utoo_payment;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
    }
}

server {
    listen 127.0.0.1:19090;
    location / {
        proxy_pass http://utoo_admin_asset;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
    }
}

server {
    listen 127.0.0.1:19091;
    location / {
        proxy_pass http://utoo_admin_platform;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
    }
}
