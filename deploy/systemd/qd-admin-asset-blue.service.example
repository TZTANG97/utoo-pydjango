# 蓝槽 admin-asset :18090

[Unit]
Description=Utoo Admin Asset Microservice (blue)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/utoo-blue/qd_svc_admin_asset
Environment=DJANGO_SETTINGS_MODULE=config.settings
ExecStart=/opt/utoo-blue/qd_svc_admin_asset/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:18090 --workers 2 --timeout 120 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
