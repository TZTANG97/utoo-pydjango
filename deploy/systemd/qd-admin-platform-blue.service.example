# 蓝槽 admin-platform :18091

[Unit]
Description=Utoo Admin Platform Microservice (blue)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/utoo-blue/qd_svc_admin_platform
Environment=DJANGO_SETTINGS_MODULE=config.settings
ExecStart=/opt/utoo-blue/qd_svc_admin_platform/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:18091 --workers 2 --timeout 120 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
