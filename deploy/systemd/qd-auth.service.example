# sudo cp qd-auth.service.example /etc/systemd/system/qd-auth.service
# sudo systemctl daemon-reload && sudo systemctl enable --now qd-auth

[Unit]
Description=Utoo Auth Microservice
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/utoo/qd_svc_auth
Environment=DJANGO_SETTINGS_MODULE=config.settings
ExecStart=/opt/utoo/qd_svc_auth/.venv/bin/gunicorn \
  config.wsgi:application \
  --bind 127.0.0.1:18081 \
  --workers 2 \
  --timeout 120 \
  --access-logfile - \
  --error-logfile -
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
