# DEPRECATED — qd_svc_auth 已并回网关 auth_pc，勿再 enable。
# 若服务器上仍有该 unit：sudo systemctl disable --now qd-auth
# C 端认证由 qd-gateway 提供；见 docs/服务合并说明.md

[Unit]
Description=Utoo Auth Microservice (DEPRECATED — do not enable)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/utoo/qd_svc_auth
Environment=DJANGO_SETTINGS_MODULE=config.settings
ExecStart=/bin/false
Restart=no

[Install]
WantedBy=multi-user.target
