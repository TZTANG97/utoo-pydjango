# 蓝槽网关 :18083
# SVC_* 指向本槽 18082/84/90/91；勿设 SVC_AUTH_URL

[Unit]
Description=Utoo Django API Gateway (blue)
After=network.target qd-order-blue.service qd-payment-blue.service qd-admin-asset-blue.service qd-admin-platform-blue.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/utoo-blue/qd_test_server_django
Environment=DJANGO_SETTINGS_MODULE=config.settings
ExecStart=/opt/utoo-blue/qd_test_server_django/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:18083 --workers 2 --timeout 120 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
