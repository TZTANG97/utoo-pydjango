# 复制到服务器：
#   sudo cp qd-gateway.service.example /etc/systemd/system/qd-gateway.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now qd-gateway
#
# 微服务模式：先 enable 上游 qd-auth/order/payment/wx/admin-asset/admin-platform，
# 网关 .env 须配置 SVC_*_URL（见 deploy/README.md）。
#
# 目录约定（与 CI 一致）：
#   /opt/utoo/qd_test_server_django
#   /opt/utoo/qd_libs_common
#   /opt/utoo/config/shared-database.env   # 密钥，勿入库
#   /opt/utoo/qd_test_server_django/.env  # 含 SVC_*_URL，勿入库

[Unit]
Description=Utoo Django API Gateway
After=network.target mysql.service redis.service qd-auth.service qd-order.service qd-payment.service qd-wx.service qd-admin-asset.service qd-admin-platform.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/utoo/qd_test_server_django
Environment=DJANGO_SETTINGS_MODULE=config.settings
# 生产勿用 runserver；gunicorn 由 CI pip 步骤安装
ExecStart=/opt/utoo/qd_test_server_django/.venv/bin/gunicorn \
  config.wsgi:application \
  --bind 127.0.0.1:18083 \
  --workers 2 \
  --timeout 120 \
  --access-logfile - \
  --error-logfile -
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
