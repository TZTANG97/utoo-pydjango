# 复制到服务器：
#   sudo cp qd-order-blue.service.example /etc/systemd/system/qd-order-blue.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now qd-order-blue
#
# 蓝槽：/opt/utoo-blue ，端口 18082
# ExecStart 必须单行（CentOS 7 / 旧 systemd 不认反斜杠续行）

[Unit]
Description=Utoo Order Microservice (blue)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/utoo-blue/qd_svc_order
Environment=DJANGO_SETTINGS_MODULE=config.settings
ExecStart=/opt/utoo-blue/qd_svc_order/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:18082 --workers 2 --timeout 120 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
