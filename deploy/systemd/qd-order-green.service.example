# 绿槽：/opt/utoo-green ，端口 18182

[Unit]
Description=Utoo Order Microservice (green)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/utoo-green/qd_svc_order
Environment=DJANGO_SETTINGS_MODULE=config.settings
ExecStart=/opt/utoo-green/qd_svc_order/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:18182 --workers 2 --timeout 120 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
