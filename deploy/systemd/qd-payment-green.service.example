# 绿槽支付（含 /api/wx）:18184

[Unit]
Description=Utoo Payment Microservice (green)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/utoo-green/qd_svc_payment
Environment=DJANGO_SETTINGS_MODULE=config.settings
ExecStart=/opt/utoo-green/qd_svc_payment/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:18184 --workers 2 --timeout 120 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
