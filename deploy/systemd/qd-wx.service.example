# DEPRECATED — qd_svc_wx 已并入 qd_svc_payment(:18084)，勿再 enable。
# 若服务器上仍有该 unit：sudo systemctl disable --now qd-wx
# 网关 SVC_WX_URL 请指向 http://127.0.0.1:18084；见 docs/服务合并说明.md

[Unit]
Description=Utoo Wx Microservice (DEPRECATED — use qd-payment)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/utoo/qd_svc_wx
Environment=DJANGO_SETTINGS_MODULE=config.settings
ExecStart=/bin/false
Restart=no

[Install]
WantedBy=multi-user.target
