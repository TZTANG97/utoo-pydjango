# sudo cp qd-wx.service.example /etc/systemd/system/qd-wx.service
# sudo systemctl daemon-reload && sudo systemctl enable --now qd-wx

[Unit]
Description=Utoo WeChat Microservice
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/utoo/qd_svc_wx
Environment=DJANGO_SETTINGS_MODULE=config.settings
ExecStart=/opt/utoo/qd_svc_wx/.venv/bin/gunicorn \
  config.wsgi:application \
  --bind 127.0.0.1:18087 \
  --workers 2 \
  --timeout 120 \
  --access-logfile - \
  --error-logfile -
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
