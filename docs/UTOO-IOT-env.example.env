# UTOO × IOT 联调环境变量示例
# 详细：docs/UTOO-IOT联调方案.md 、docs/UTOO-IOT本机交叉配置.md
#
# 写到哪里：
# - order 微服务：utoo-pydjango/qd_svc_order/.env.local
# - IOT 服务器：/opt/laidecloud/shared/.env.* 或本机 E:\IOT\iot\.env
#
# 硬约束：两端不在同一服务器时，跨机禁止写对方 127.0.0.1

# ---------- 异机生产 / UAT HTTPS（默认）----------
IOT_BASE_URL=https://www.laidecloud.com
IOT_SERVICE_TOKEN=change-me-service-token
IOT_HMAC_SECRET=change-me-hmac-secret
IOT_APP_ID=utoo-iot
# IOT_CALLBACK_IP_WHITELIST=203.0.113.10,198.51.100.20
IOT_HTTP_TIMEOUT=15
IOT_UTOO_CALLBACK_URL=https://uat.utoodev.laide.tech/api/iot/callback/experiment-event
# IOT 侧：
# UTOO_CALLBACK_URL=https://uat.utoodev.laide.tech/api/iot/callback/experiment-event
# UTOO_HMAC_SECRET=change-me-hmac-secret
# UTOO_APP_ID=utoo-iot
# UTOO_SERVICE_TOKEN=change-me-service-token

# ---------- 仅本机同机开发（例外）----------
# IOT_BASE_URL=http://127.0.0.1:18088
# IOT_UTOO_CALLBACK_URL=http://127.0.0.1:18083/api/iot/callback/experiment-event
# UTOO_CALLBACK_URL=http://127.0.0.1:18083/api/iot/callback/experiment-event
