# 数据库/JWT：见 E:\utoo\config\shared-database.env（复制 .example 后填写）
# 本文件只配服务端口等；.env.local 可覆盖任意项
# JWT 与订单/鉴权中台统一：优先读 shared-database.env 的 JWT_SECRET_KEY

APP_ENV=development
SERVER_HOST=0.0.0.0
# 本机开发 18110；UTOO 生产蓝/绿为 18081/18181，网关只打 Nginx :19081
SERVER_PORT_HTTP=18110
JWT_ISSUER=qd_svc_identity
# 青岛 admin-web 兼容：与 mall gateway JWT_SECRET / JWT_ISSUER 对齐
MALL_JWT_ISSUER=qd-mall-identity
