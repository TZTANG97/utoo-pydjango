# 数据库/JWT：见 E:\\utoo\\config\\shared-database.env（复制 .example 后填写）
# 本文件只配服务端口等；.env.local 可覆盖任意项

APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT_HTTP=18082

# 订单资料本地上传（相对本服务根目录）；50MB=52428800
UPLOAD_DIR=upload
MAX_UPLOAD_SIZE=104857600
# IMAGE_WEB_SERVER=

# 公众号模板消息（复制网关 WEIXIN_GZH_*；WEIXIN_GZH_SEND=0 关闭）
