# 数据库/JWT：见 E:\\utoo\\config\\shared-database.env（复制 .example 后填写）
# 本文件只配服务端口等；.env.local 可覆盖任意项

APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT_HTTP=18084

# 公众号扫码登录（原 qd_svc_wx；未配则 /api/wx QR 接口返回未配置）
# 若网关配置了 SVC_WX_URL 指向本服务，以下项必须在本进程生效；
# wechatconfig 回调默认由网关本地处理（需与本服务共用 REDIS_URL）
WEIXIN_GZH_APPID=
WEIXIN_GZH_SECRET=
WEIXIN_GZH_TOKEN=
WEIXIN_GZH_MINI_THUMB_MEDIA_ID=
WEIXIN_MP_APPID=
WEIXIN_MP_SECRET=
WEIXIN_MP_AUTH_PAGEPATH=staffB/auth_phone/auth_phone
# WEIXIN_APPID=
# WEIXIN_SECRET=
