# 数据库：复制 config/shared-database.env.example → config/shared-database.env 并填写 DB_*
# 所有 Django 服务（网关 + qd_svc_*）自动加载该文件；本机覆盖可用 .env.local

# Redis — 对齐 Java config-test.properties
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=1
REDIS_TIMEOUT=10000

# 服务
APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT_HTTP=18083

# 微服务上游（整段注释掉则回退网关本地单体）
# 生产红绿部署经 Nginx 稳定内部端口访问，单服务切流无需重启网关。
# 本机直连调试时，可改回对应服务的实际端口。
# 启用后须启动对应上游，否则该域 API 返回 503。一键：scripts/start-ms-dev.ps1
# 对内中台推进：docs/中台后续流程与复杂度.md
#
# C 端认证已并回网关 auth_pc，勿再设 SVC_AUTH_URL / 勿启 qd_svc_auth(:18081)
# SVC_AUTH_URL=
# 身份中台（员工 login/menus + 会员 login/me/refresh）
# 本机：http://127.0.0.1:18110 ；UTOO 生产经 Nginx 稳定口：http://127.0.0.1:19081
# SVC_IDENTITY_URL=http://127.0.0.1:18110
# 本机日常联调：下面整段保持注释 → 网关单体（含扫码二维码）
# 微服务联调：取消注释并先启动 scripts/start-ms-dev.ps1（端口用 1808x，非 1908x）
# SVC_ORDER_URL=http://127.0.0.1:18082
# 支付 + 原微信接口同进程（qd_svc_payment）；勿再启 qd_svc_wx(:18087)
# SVC_WX_URL 仅转发扫码/预约/反馈 4 个接口；小程序 /api/wx/* 登录等始终走网关 wx_mp
# SVC_PAYMENT_URL=http://127.0.0.1:18084
# SVC_WX_URL=http://127.0.0.1:18084
# SVC_ADMIN_ASSET_URL=http://127.0.0.1:18090
# SVC_ADMIN_PLATFORM_URL=http://127.0.0.1:18091
# 入驻/发票已并入 platform（勿再启 qd_svc_entry / qd_svc_invoice）
# SVC_INVOICE_URL=http://127.0.0.1:18091
# SVC_ENTRY_URL=http://127.0.0.1:18091
# 微信回调公网根（预下单 notify_url 用，通常与网关一致；下方 CORS_HTTPS 也有正式配置）
# CORS_HTTPS=http://127.0.0.1:18083
API_PREFIX=/api
DEBUG_RELOAD=true

# Django
DJANGO_SECRET_KEY=change-me-in-production

# JWT（与 FastAPI 对齐，生产务必修改）
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 开发环境固定短信码
DEV_SMS_CODE=111111

# 支付调试 / 并发（D2 启用 Celery 任务）
PAY_DEBUG_ENABLED=true
PAY_NOTIFY_USE_QUEUE=true
PAY_USER_LOCK_SECONDS=30
PAY_NOTIFY_LOCK_SECONDS=120

# 阿里云短信
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=

# OSS
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_BUCKET=qgongye
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=https://qgongye.oss-cn-shanghai.aliyuncs.com

IMAGE_WEB_SERVER=https://qgongye.oss-cn-shanghai.aliyuncs.com
UPLOAD_DIR=upload
# 50MB=52428800（订单/发票资料；过低会 HTTP 413）
MAX_UPLOAD_SIZE=104857600

# 微信
WEIXIN_APPID=
WEIXIN_SECRET=
# 小程序一键登录（愉兔 / 途哲）；开发可设 DEV_WX_PHONE 跳过微信解密
# 扫码登录推送小程序卡片也依赖 WEIXIN_MP_APPID（对应 Java weixin.appid）
WEIXIN_MP_APPID=
WEIXIN_MP_SECRET=
WEIXIN_MP_TZ_APPID=
WEIXIN_MP_TZ_SECRET=
DEV_WX_PHONE=
# PC 扫码登录：公众号（对应 Java gzh.appid / gzh.secret / gzh.token）
# 未配置时 /api/wx/WeChatQRCodeGenerator.ajax 返回 501
# 公众号后台「服务器配置」URL = {CORS_HTTPS}/api/wx/wechatconfig.ajax ，Token = WEIXIN_GZH_TOKEN
# 回调与二维码轮询须共用同一 Redis（单体网关，或网关+payment 同 REDIS_URL）
WEIXIN_GZH_APPID=
WEIXIN_GZH_SECRET=
WEIXIN_GZH_TOKEN=
# 客服消息小程序卡片封面素材 media_id（公众号素材库）；不配则跳过推卡仍可写 Redis
WEIXIN_GZH_MINI_THUMB_MEDIA_ID=
# 公众号模板消息开关（对齐 Java gzh.send，1=发送 / 0=关闭）
WEIXIN_GZH_SEND=1
# 扫码授权页路径（分包），默认 staffB/auth_phone/auth_phone
WEIXIN_MP_AUTH_PAGEPATH=staffB/auth_phone/auth_phone
WEIXIN_MERCHANT_ID=
WEIXIN_MERCHANT_SERIAL_NUMBER=
WEIXIN_API_V3_KEY=
WEIXIN_PRIVATE_KEY_PATH=e:/utoo/qd_test_server_django/certs/apiclient_key.pem
CORS_HTTPS=https://uat.utoo.laide.tech

# Celery（默认与 Redis 同机）
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
