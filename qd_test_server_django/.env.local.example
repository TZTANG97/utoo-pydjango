# 复制为 .env.local，会覆盖 .env 中同名项（勿提交 .env.local）
# 场景：UAT 账号无 qd_pt_new 权限，或改用本机 MySQL

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=qd_pt_new

# --- 可选：临时关闭 / 改微服务上游（覆盖 .env 中的 SVC_*）---
# 回退单体：把对应 SVC_* 设为空字符串，或整段注释后删除本机已写入的空值键
# 勿设 SVC_AUTH_URL（C 端认证在网关）；SVC_WX_URL 与 payment 同指 :18084
# 身份中台本机 :18110；生产经 Nginx :19081。空则回退网关本地登录。
# SVC_IDENTITY_URL=
# SVC_ORDER_URL=
# SVC_PAYMENT_URL=
# SVC_ADMIN_ASSET_URL=
# SVC_ADMIN_PLATFORM_URL=
# SVC_INVOICE_URL=
# SVC_ENTRY_URL=
# SVC_WX_URL=http://127.0.0.1:18084
#
# 只改某一上游地址示例：
# SVC_ORDER_URL=http://127.0.0.1:18082
