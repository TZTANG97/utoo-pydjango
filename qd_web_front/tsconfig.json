{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@client/*": ["src/client/*"],
      "@admin/*": ["src/admin/*"],
      "@shared/*": ["src/shared/*"],
      "@/*": ["src/client/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.js", "env.d.ts"]
}
