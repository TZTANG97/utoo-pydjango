# utoo_biz 本机联调（复制为 .env.local；start-dev.ps1 也会从 scripts/dev.env 注入）
# 各中台 URL 必须显式配置，否则对应 proxy 503（勿依赖默认 localhost）
# 生产：APP_ENV=production 时缺 UTOO_*_MID（或 SVC_* 回落）→ 拒绝启动
# APP_ENV=development
UTOO_ORDER_MID_SERVICE_URL=http://127.0.0.1:18082
UTOO_PAYMENT_MID_SERVICE_URL=http://127.0.0.1:18084
UTOO_PLATFORM_MID_SERVICE_URL=http://127.0.0.1:18091
UTOO_IDENTITY_MID_SERVICE_URL=http://127.0.0.1:18110
UTOO_GATEWAY_INTERNAL_URL=http://127.0.0.1:18083
UTOO_ASSET_MID_SERVICE_URL=http://127.0.0.1:18090
UTOO_MID_PROXY_TIMEOUT_SECONDS=15
